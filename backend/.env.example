# Password login (uses the app ID built into ewelink-api: devices can be listed but not switched)
EWELINK_REGION=
EWELINK_USERNAME=
EWELINK_PASSWORD=

# OAuth login with your own app from https://dev.ewelink.cc (needed to switch devices on/off).
# When both are set, the password settings above are ignored.
EWELINK_APP_ID=
EWELINK_APP_SECRET=
# Must be registered as the app's redirect URL. Defaults to http://localhost:3000/api/oauth/callback
EWELINK_OAUTH_REDIRECT_URL=
# Where the browser returns after authorizing. Defaults to http://localhost:5173
FRONTEND_URL=
