{
  "name": "ewelink-local-control-backend",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "node --use-system-ca --watch src/server.js",
    "start": "node --use-system-ca src/server.js",
    "pretest": "node -e \"require('node:fs').mkdirSync('coverage', { recursive: true })\"",
    "test": "node --test --experimental-test-coverage --test-coverage-include=\"src/**\" --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info \"test/*.test.js\""
  },
  "dependencies": {
    "dotenv": "^18.0.9",
    "@scalar/express-api-reference": "^0.10.31",
    "express": "^5.3.0",
    "ewelink-api": "git+https://github.com/baugp/ewelink-api.git#master"
  }
}
